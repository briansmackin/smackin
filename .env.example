# Template only. Set real values in the deployment's secret manager.
# Production requires HTTPS, an approved app, and an explicit allowed company ID.
PUBLIC_ORIGIN=https://YOUR-CONNECTOR-HOST
QBO_ENV=sandbox
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_ALLOWED_REALM_ID=
TOKEN_ENCRYPTION_KEY_BASE64=
ADMIN_USER=brian
# Generate with: node scripts/hash-password.mjs (password is read from stdin)
ADMIN_PASSWORD_SCRYPT=
# Independent random secret for Grok GET requests; never put it in a URL.
ERP_READ_KEY=
DATA_DIR=./data
PORT=3000
HOST=127.0.0.1
# Draft policies remain visibly marked until reviewed and enabled.
POLICIES_APPROVED=false
